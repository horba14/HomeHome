["import React from 'react';\r\nimport '../styles/WhyWeSection.css';\r\n\r\nconst WhyWeSection = () => {\r\n    return (\r\n        <section className=\"why-we-section\">\r\n            <div className=\"why-we-left\">\r\n                <img src={`${process.env.PUBLIC_URL}/imgg/Group 67.png`} alt=\"Чому ми?\" />\r\n            </div>\r\n            <div className=\"why-we-right\">\r\n                <h2 className=\"why-we-title\">Чому ми?</h2>\r\n                \r\n                <div className=\"why-we-text\">\r\n                    Home Space — це не просто меблі чи декор, це простір, який працює на вас.\r\n                </div>\r\n                \r\n                <div className=\"why-we-description\">\r\n                    Ми віримо, що дім має бути не лише красивим, а й зручним, розумним, гнучким — таким, що підлаштовується під ваше життя, а не навпаки. Наші рішення поєднують продуманий функціональний дизайн, натуральні матеріали та естетику, яка не втрачає актуальності з часом. Ми надихаємося скандинавською простотою, де кожна деталь має сенс, а речі приносять радість — не лише виглядом, а й використанням.\r\n                </div>\r\n                <div className=\"why-we-description\">\r\n                    Обираючи Home Space, ви обираєте турботу: про комфорт, про організований простір, про атмосферу, в якій хочеться залишатися. Ми дбаємо про якість на кожному етапі — від ідеї до доставки, щоб ви могли зібрати свій простір легко, із задоволенням і без зайвого клопоту.\r\n                </div>\r\n                <div className=\"why-we-description\">\r\n                    Для нас важливо не просто продати — ми прагнемо стати частиною вашої історії дому. Простору, який стане відображенням вас.\r\n                </div>\r\n                \r\n                <a href=\"#\" className=\"why-we-btn\">Детальніше</a>\r\n            </div>\r\n        </section>\r\n    );\r\n};\r\n\r\nexport default WhyWeSection;"],"mappings":";AAAA,OAAOA,KAAK,MAAM,OAAO;AACz